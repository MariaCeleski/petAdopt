# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/petadopt_db?schema=public"

# NextAuth.js Configuration  
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email Service Configuration (SendGrid or Resend)
# Option 1: SendGrid
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@petadopt.com"

# Option 2: Resend (alternative)
# RESEND_API_KEY="your-resend-api-key"

# SMTP Configuration (alternative to SendGrid/Resend)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-email-password"

# Application Configuration
APP_URL="http://localhost:3000"
APP_NAME="PetAdopt"

# Security
BCRYPT_SALT_ROUNDS="12"

# File Upload Limits
MAX_FILE_SIZE="5242880"  # 5MB in bytes
MAX_FILES_PER_PET="10"