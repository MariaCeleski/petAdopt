{
  "name": "petadopt-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/seed-database.js",
    "db:test": "node scripts/test-connection-pooling.js",
    "db:validate": "node scripts/validate-prisma.js",
    "postinstall": "prisma generate",
    "test": "echo \"No unit tests configured yet\"",
    "test:watch": "echo \"No unit tests configured yet\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "fast-check": "^4.9.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-auth": "^4.24.15",
    "next-cloudinary": "^6.18.8",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma-erd-generator": "^2.5.0"
  }
}
