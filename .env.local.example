# ============================================
# CLOUDINARY - Image Upload Service
# ============================================
# REQUIRED for pet image uploads to work!

# Get these from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="petadopt_unsigned"

# Backend only (keep secret!)
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# ============================================
# DATABASE (if using local SQLite)
# ============================================
# DATABASE_URL="file:./prisma/dev.db"

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# EMAIL SERVICE
# ============================================
# Use ONE of these options:

# Option 1: Resend (Recommended for development)
RESEND_API_KEY="your_resend_api_key_here"

# Option 2: SendGrid
# SENDGRID_API_KEY="your_sendgrid_api_key_here"

# Option 3: SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_app_password"
# SMTP_SECURE="false"

EMAIL_FROM="noreply@petadopt.local"

# ============================================
# APPLICATION
# ============================================
APP_URL="http://localhost:3000"
APP_NAME="PetAdopt"

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copy this file to .env.local
# 2. Fill in your credentials
# 3. Do NOT commit .env.local (already in .gitignore)
# 4. Restart dev server: npm run dev
